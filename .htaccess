# DirectAdmin (this box, version 1.711) only supports a custom docroot for
# subdomains, not the account's primary domain -- so ahmedia.ai's docroot
# stays public_html (this directory, the full app checkout) instead of
# public_html/public like it would with a real docroot override. This file
# transparently rewrites every request into public/ before Laravel (or
# Apache's own static-file serving) ever sees the original path, so
# app/, .env, vendor/, etc. are never directly reachable even though they
# technically sit under the web-facing directory.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Send stray /public/... URLs (old redirects, bookmarks) to the clean URL.
    # THE_REQUEST is the visitor's original request line, so this never
    # matches the internal rewrite below.
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/public/(\S*)\s [NC]
    RewriteRule ^ /%1 [NE,L,R=301]

    # Strip trailing slashes here rather than leaving it to Laravel's rule in
    # public/.htaccess: by then the path has been rewritten to /public/...,
    # so that rule would redirect visitors to /public/approach.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
