      "id": "985e903e-6041-43b3-8b99-e4c59d57905c",
      "name": "Collect Image Filenames",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        7904
      ]
    },
    {
      "parameters": {
        "jsCode": "const assembled = $('Assemble Payload').item.json;\nconst report = $('Field Report Chain').item.json.text || '';\nconst filenames = $json.filenames || [];\nconst capturedAt = assembled.captured_at || $now.toISO();\nconst slug = String(capturedAt).replace(/[:.]/g, '-').slice(0, 19);\n\nconst locationBlock = assembled.location\n  ? `location:\\n  latitude: ${assembled.location.latitude}\\n  longitude: ${assembled.location.longitude}\\n`\n  : '';\n\nconst frontmatter = `---\\ntitle: ${capturedAt} Field Report\\ntype: field-report\\ncaptured_at: ${capturedAt}\\n${locationBlock}source: telegram-capture\\ntags:\\n  - field-report\\n---\\n\\n`;\n\nconst transcriptSection = assembled.voice_transcript\n  ? `\\n\\n**Voice Transcript:**\\n${assembled.voice_transcript}`\n  : '';\n\nconst embeds = filenames.map(f => `![[${f}]]`).join('\\n');\nconst body = report + transcriptSection + (embeds ? `\\n\\n${embeds}` : '');\n\nreturn [{ json: { filename: `${slug}.md`, content: frontmatter + body } }];"
      },
