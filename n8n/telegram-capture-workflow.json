      "parameters": {
        "jsCode": "const update = $input.item.json;\nconst message = update.message ?? update.callback_query?.message;\nconst callbackData = update.callback_query?.data;\n\nconst text = update.message?.text ?? '';\nconst command = text.startsWith('/')\n  ? text.split(' ')[0].split('@')[0].toLowerCase()\n  : callbackData;\n\nconst type = update.message?.photo ? 'photo'\n  : update.message?.voice ? 'voice'\n  : update.message?.location ? 'location'\n  : text ? 'text'\n  : callbackData ? 'callback'\n  : 'unknown';\n\nreturn [{\n  json: {\n    chat_id: message?.chat?.id,\n    user_id: update.message?.from?.id ?? update.callback_query?.from?.id,\n    message_id: message?.message_id,\n    command: command ?? null,\n    text,\n    type,\n    voice_file_id: update.message?.voice?.file_id ?? null,\n    photo_file_id: update.message?.photo?.at(-1)?.file_id ?? null,\n    latitude: update.message?.location?.latitude ?? null,\n    longitude: update.message?.location?.longitude ?? null,\n    caption: update.message?.caption ?? ''\n  }\n}];"
      },
