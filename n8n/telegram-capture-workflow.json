    {
      "parameters": {
        "jsCode": "const assembled = $('Assemble Payload').item.json;\nconst capturedAt = assembled.captured_at || $now.toISO();\nconst slug = String(capturedAt).replace(/[:.]/g, '-').slice(0, 19);\nconst images = assembled.images || [];\n\n// Always emit at least one item so downstream nodes still run when there\n// are zero images \u2014 n8n halts a branch entirely when a node outputs\n// zero items, which would otherwise skip note-writing on image-less captures.\nif (images.length === 0) {\n  return [{ json: { file_id: null, filename: null } }];\n}\n\nreturn images.map((img, i) => ({\n  json: {\n    file_id: img.file_id,\n    filename: `${slug}-${i + 1}.jpg`\n  }\n}));"
      },
