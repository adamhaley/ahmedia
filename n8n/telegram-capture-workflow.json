    {
      "parameters": {
        "jsCode": "const items = $('Load Session Items').all().map(i => i.json);\nconst transcripts = $json.transcripts || [];\n\nconst text = items\n  .filter(i => i.type === 'text' || i.caption)\n  .map(i => i.text || i.caption)\n  .filter(Boolean)\n  .join('\\n');\n\nconst locationItem = items.find(i => i.type === 'location');\nconst photoItems = items.filter(i => i.type === 'photo' && i.file_id);\n\nreturn [{\n  json: {\n    session_id: items[0]?.session_id ?? null,\n    request_type: 'field_report',\n    text,\n    location: locationItem\n      ? { latitude: locationItem.latitude, longitude: locationItem.longitude }\n      : null,\n    voice_transcript: transcripts.length ? transcripts.join('\\n') : null,\n    images: photoItems.map(i => ({ file_id: i.file_id })),\n    captured_at: items[0]?.created_at ?? null\n  }\n}];"
      },
      "id": "ddcfedd0-5203-46c3-8cc2-bea05f52d278",
      "name": "Assemble Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
        4480
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are summarizing a single field-report capture sent via Telegram (text notes, an optional GPS location, an optional voice transcript, and optional images from one capture session).\n\nWrite a short, plain field report a person could read later to understand what was observed, where, and any notable details.\n\nRules:\n- Only report information given in the input below. Never invent details, addresses, or context not present.\n- If location coordinates are given, state them plainly as coordinates. Do not attempt to reverse-geocode into a place name.\n- If voice transcript or images are 'none', do not comment on their absence.\n- Keep the report to a few sentences, factual and plain. No headers or bullet lists unless the input clearly contains multiple distinct items.\n- Reply with the report text only \u2014 no preamble like \"Here is your report\" or \"Thank you\", and no closing offer to help further.\n\nField report capture:\n\nText notes: {{ $json.text || 'none' }}\n\nLocation: {{ $json.location ? ($json.location.latitude + ', ' + $json.location.longitude) : 'none' }}\n\nVoice transcript: {{ $json.voice_transcript || 'none' }}\n\nImages: {{ $json.images && $json.images.length ? $json.images.length + ' image(s) attached' : 'none' }}"
      },
      "id": "99c82537-203e-438f-98e8-7208a2f7e96d",
      "name": "Field Report Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1824,
        4480
      ],
      "notesInFlow": true,
      "notes": "Deliberately scoped and tool-less \u2014 not the shared 'AH Core' agent, and a Basic LLM Chain rather than an Agent node (no ReAct tool loop, less prone to the flakiness Agent nodes can have). Just synthesizes the assembled capture payload into a short report; no tools, no memory, can't touch calendars/journals/Slack. Verify the output field name after a test run (chainLlm typically outputs under 'text'; Send Result's expression assumes that \u2014 adjust if your n8n version differs)."
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini",
          "cachedResultName": "gpt-4.1-mini",
          "cachedResultUrl": ""
        },
        "options": {}
      },
      "id": "f7b145dd-5c92-4607-8234-93010b3abcfb",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1824,
        4656
      ],
      "credentials": {
