APP_NAME="AH Media.ai"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ahmedia.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Standardized on MySQL -- never SQLite, dev or test (see dotclaude/rules/testing.md
# and dreamworldcirque's 2026-09-24 incident: SQLite tests stayed green while a
# MySQL-only quirk corrupted production data).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahmedia_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Carried over from the pre-Laravel static site's api/chat.php proxy (now in
# legacy-static/api/) -- not yet wired into the Laravel app. Needed once the
# chat widget backend is ported to real controllers (see the port plan's
# "Rebuild the chat widget backend" step, modeled on dreamworldcirque's Chat
# controllers/ChatQuery model).
# N8N_WEBHOOK_KEY=
# N8N_WEBHOOK_HEADER_NAME=X-N8N-API-KEY
# N8N_CHAT_WEBHOOK_URL=https://n8n.ahmedia.ai/webhook/rag_chat
# N8N_UPLOAD_WEBHOOK_URL=https://n8n.ahmedia.ai/webhook/ingest_file

# Coming-soon gate (see the 2026-10-01 deploy plan) -- enabled in production
# until Adam flips it off for real launch. Visit /preview/{token} once to set
# a long-lived bypass cookie for that browser.
COMING_SOON_ENABLED=false
COMING_SOON_BYPASS_TOKEN=
